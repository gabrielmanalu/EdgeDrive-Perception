# ============================================================================
# EdgeDrive Perception — .gitignore
# ============================================================================

# ── Large binary files — download or generate locally ─────────────────────

# TensorRT engines (device-specific, not transferable)
*.engine
*.trt

# Model weights
*.pt
*.pth
*.onnx
*.wts

# TFLite models
*.tflite

# Video files
*.mp4
*.avi
*.mov
*.mkv

# ── Dataset and generated data ────────────────────────────────────────────

# nuScenes dataset (too large, download from nuscenes.org)
data/

# Test images and videos (generated locally)
test_images/
test_videos/

# Output files
output/
logs/

# ── Build artifacts ───────────────────────────────────────────────────────

# C++ build
deployment/build/

# ROS2 colcon build artifacts
ros2_ws/build/
ros2_ws/install/
ros2_ws/log/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
*.egg-info/
dist/
build/

# ── IDE and OS files ──────────────────────────────────────────────────────

.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Docker volumes ────────────────────────────────────────────────────────

# ROS2 bags (generated from nuScenes conversion)
bags/

# ── Keep these (explicitly) ───────────────────────────────────────────────

# calibration_images/ ← 14MB, needed for INT8 engine build — DO NOT ignore
# calibration.yaml    ← tiny config — DO NOT ignore
# weights/.gitkeep    ← placeholder so folder exists — DO NOT ignore

# ROS2 bags (too large for git — generate with nuscenes_to_ros2bag.py)
bags/