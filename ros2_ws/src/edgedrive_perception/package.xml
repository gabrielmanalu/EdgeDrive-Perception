<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>edgedrive_perception</name>
  <version>1.0.0</version>
  <description>
    EdgeDrive Perception ROS2 package.
    Real-time camera detection and camera-LiDAR fusion on Jetson Orin Nano Super.
    Uses YOLO26n TensorRT INT8 for camera detection and PointPillars for LiDAR.
  </description>
  <maintainer email="gabriel@edgedrive.ai">Gabriel</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Core ROS2 -->
  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>

  <!-- Message types -->
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>vision_msgs</depend>
  <depend>visualization_msgs</depend>

  <!-- Image transport + CV bridge -->
  <depend>image_transport</depend>
  <depend>cv_bridge</depend>

  <!-- Camera-LiDAR sync -->
  <depend>message_filters</depend>

  <!-- TF2 for transforms -->
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <!-- PCL — added when fusion_node is implemented -->
  <!-- <depend>pcl_conversions</depend> -->
  <!-- <depend>pcl_ros</depend> -->

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>