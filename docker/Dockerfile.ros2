# ============================================================================
# EdgeDrive Perception — ROS2 Development Container
# ============================================================================
#
# Purpose: ROS2 Humble development environment for sensor fusion demo.
#          Used for nuScenes bag replay, camera_node, and fusion_node.
#
# Base: nvcr.io/nvidia/l4t-jetpack:r36.4.0
#   Same base as production container → TRT 10.3.0 matches our engines.
#   No engine rebuild needed unlike dusty-nv (which ships TRT 10.4.0).
#
# Includes:
#   - ROS2 Humble Desktop
#   - colcon build tools
#   - cv_bridge, image_transport, vision_msgs
#   - CUDA 12.6, TensorRT 10.3.0 (from base)
#   - OpenCV 4.8.0 (from base)
#
# Build:
#   docker build -t edgedrive-ros2:latest -f docker/Dockerfile.ros2 .
#
# Run:
#   docker compose -f docker/docker-compose.ros2.yml run --rm camera-node
# ============================================================================

FROM nvcr.io/nvidia/l4t-jetpack:r36.4.0

LABEL maintainer="EdgeDrive Perception"
LABEL description="ROS2 Humble dev container — TRT 10.3.0, Jetson Orin Nano Super"
LABEL version="1.0"

# Prevent interactive prompts during apt installs (e.g. tzdata)
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Tokyo

# ── ROS2 Humble installation ──────────────────────────────────────────────────

# Locale
RUN apt-get update && apt-get install -y --no-install-recommends \
    locales curl gnupg2 lsb-release software-properties-common \
    && locale-gen en_US en_US.UTF-8 \
    && update-locale LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8 \
    && rm -rf /var/lib/apt/lists/*

ENV LANG=en_US.UTF-8

# ROS2 apt repository
RUN add-apt-repository universe && \
    curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
         -o /usr/share/keyrings/ros-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] \
         http://packages.ros.org/ros2/ubuntu $(lsb_release -cs) main" \
         > /etc/apt/sources.list.d/ros2.list

# ROS2 Humble + perception packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-humble-desktop \
    ros-humble-cv-bridge \
    ros-humble-image-transport \
    ros-humble-image-transport-plugins \
    ros-humble-vision-msgs \
    ros-humble-visualization-msgs \
    ros-humble-tf2-ros \
    ros-humble-tf2-geometry-msgs \
    ros-humble-rosbag2 \
    ros-humble-rosbag2-storage-default-plugins \
    ros-humble-sensor-msgs \
    ros-humble-pcl-conversions \
    ros-humble-pcl-ros \
    python3-colcon-common-extensions \
    python3-rosdep \
    python3-argcomplete \
    # GStreamer for NVDEC
    gstreamer1.0-tools \
    gstreamer1.0-plugins-good \
    gstreamer1.0-plugins-bad \
    gstreamer1.0-libav \
    v4l-utils \
    && rm -rf /var/lib/apt/lists/*

# rosdep init
RUN rosdep init && rosdep update

# ── Build ROS2 package ────────────────────────────────────────────────────────

WORKDIR /workspace

# Source ROS2 on every bash session
RUN echo "source /opt/ros/humble/setup.bash" >> /root/.bashrc

# Fix Python3 interpreter path conflict between l4t-jetpack and ROS2
# l4t-jetpack installs python3 at /usr/local/bin/python3
# ROS2 ament_cmake expects /usr/bin/python3
RUN ln -sf /usr/bin/python3 /usr/local/bin/python3 || true

# ── Copy package manifests first (cache-friendly layer order) ─────────────────
# Docker caches layers until files change. By copying package.xml and
# CMakeLists.txt before source files, dependency resolution is cached
# as long as manifests don't change — only source changes trigger recompile.
COPY ros2_ws/src/edgedrive_perception/package.xml \
     ros2_ws/src/edgedrive_perception/package.xml
COPY ros2_ws/src/edgedrive_perception/CMakeLists.txt \
     ros2_ws/src/edgedrive_perception/CMakeLists.txt

# ── Copy source files (triggers recompile only when source changes) ───────────
COPY ros2_ws/ ros2_ws/
COPY deployment/src/ deployment/src/
COPY deployment/include/ deployment/include/
COPY deployment/CMakeLists.txt deployment/CMakeLists.txt

# Build — ~25s on cache hit (only relinking), ~50s on source change
RUN bash -c "source /opt/ros/humble/setup.bash && \
             cd ros2_ws && \
             colcon build --packages-select edgedrive_perception \
             --cmake-args -DCMAKE_BUILD_TYPE=Release \
             --event-handlers console_cohesion+"

# Source workspace on every bash session
RUN echo "source /workspace/ros2_ws/install/setup.bash" >> /root/.bashrc

# ── Entrypoint ────────────────────────────────────────────────────────────────

COPY docker/ros2_entrypoint.sh /ros2_entrypoint.sh
RUN chmod +x /ros2_entrypoint.sh

ENTRYPOINT ["/ros2_entrypoint.sh"]
CMD ["bash"]